rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function ownerUnchanged() {
      return !('ownerId' in request.resource.data) ||
        request.resource.data.ownerId == resource.data.ownerId;
    }

    function validOwnerWrite() {
      return isOwner(request.resource.data.ownerId);
    }

    match /users/{userId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /orders/{orderId}/items/{itemId} {
      allow read, write: if isSignedIn() &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.ownerId == request.auth.uid;
    }

    match /{collection}/{docId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if validOwnerWrite();
      allow update: if isOwner(resource.data.ownerId) && ownerUnchanged();
      allow delete: if isOwner(resource.data.ownerId);
    }
  }
}
