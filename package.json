{
  "name": "rsho",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "expo-go": "expo start --clear",
    "prebuild": "expo prebuild --platform ios",
    "prebuild:clean": "expo prebuild --clean --platform ios",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:android:clean": "expo prebuild --clean --platform android",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/**/*.test.ts tests/repositories/**/*.test.ts",
    "test:security": "firebase emulators:exec --only firestore \"tsx --test tests/security/**/*.test.ts\"",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --only firestore,auth,functions \"tsx --test tests/integration/**/*.test.ts\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@fluentui/react-native-icons": "^2.0.335",
    "@hookform/resolvers": "^5.7.1",
    "@maplibre/maplibre-react-native": "^11.3.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-blur": "~57.0.0",
    "expo-constants": "~57.0.2",
    "expo-font": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-location": "~57.0.1",
    "expo-router": "~57.0.2",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.3",
    "firebase": "^12.17.1",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "react-native-screens": "$react-native-screens",
    "react-native-worklets": "0.12.1",
    "typescript": "$typescript"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eas-cli": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.26.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  }
}
