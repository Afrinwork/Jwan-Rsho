{
  "name": "rsho",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "expo-go": "expo start --clear",
    "prebuild": "expo prebuild --platform ios",
    "prebuild:clean": "expo prebuild --clean --platform ios",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:android:clean": "expo prebuild --clean --platform android",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:security": "firebase emulators:exec --only firestore,storage \"tsx --test tests/security/**/*.test.ts\"",
    "test:security-supabase": "tsx --test tests/security-supabase/**/*.test.ts",
    "test:functions-supabase": "tsx --test tests/functions-supabase/**/*.test.ts",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --only firestore,auth,functions \"tsx --test tests/integration/**/*.test.ts\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@fluentui/react-native-icons": "^2.0.335",
    "@hookform/resolvers": "^5.7.1",
    "@maplibre/maplibre-react-native": "^11.3.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~58.0.20",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "i18next": "^26.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "react-native-screens": "$react-native-screens",
    "react-native-worklets": "$react-native-worklets",
    "typescript": "$typescript"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.1",
    "babel-preset-expo": "~58.0.0",
    "eas-cli": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.26.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  }
}
