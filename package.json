{
  "name": "rsho",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "expo-go": "expo start --clear",
    "prebuild": "expo prebuild --platform ios",
    "prebuild:clean": "expo prebuild --clean --platform ios",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/**/*.test.ts tests/repositories/**/*.test.ts",
    "test:security": "firebase emulators:exec --only firestore \"tsx --test tests/security/**/*.test.ts\"",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --only firestore,auth,functions \"tsx --test tests/integration/**/*.test.ts\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.7.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.7",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.85.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^10.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.26.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
