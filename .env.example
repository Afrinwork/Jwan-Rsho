# Supabase (the app's only backend). Find both in the Supabase dashboard
# under Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Separate key from the Android Maps SDK key in app.json — that one is
# restricted to the Android app and does not work for direct Directions/Geocoding
# API calls. Create a new key in Google Cloud Console, enable both the
# "Directions API" and the "Geocoding API" for it (no app restriction, since
# calls come straight from the client), and set a billing budget alert.
EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY=your-directions-api-key
