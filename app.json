{
  "expo": {
    "name": "Rasho SmartPlan",
    "slug": "rsho",
    "scheme": "rsho",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rasho SmartPlan verwendet deinen Standort, um deine Position auf der Karte anzuzeigen und Navigation zu Kunden zu starten."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rasho SmartPlan benoetigt die Kamera, um beim Morgen-Check ein Foto vom Kilometerstand aufzunehmen."
        }
      ],
      "expo-font",
      "expo-updates",
      "./plugins/withAndroidMapsQueries.js",
      "@maplibre/maplibre-react-native"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rsho.cheeseorders",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rasho SmartPlan verwendet deinen Standort, um deine Position auf der Karte anzuzeigen und Navigation zu Kunden zu starten.",
        "NSCameraUsageDescription": "Rasho SmartPlan benoetigt die Kamera, um beim Morgen-Check ein Foto vom Kilometerstand aufzunehmen.",
        "NSPhotoLibraryUsageDescription": "Rasho SmartPlan benoetigt Zugriff auf Fotos, um das Kilometerstand-Foto beim Morgen-Check zu speichern.",
        "CFBundleLocalizations": [
          "de",
          "ar"
        ],
        "CFBundleDevelopmentRegion": "de",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.rsho.cheeseorders",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#02234B"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35c435d9-670d-464d-805f-3a44a660bfd0"
      }
    },
    "owner": "m.hannan1997",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/35c435d9-670d-464d-805f-3a44a660bfd0"
    }
  }
}
